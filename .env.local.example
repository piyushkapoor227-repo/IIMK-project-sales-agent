# --- Option 1: offline demo (no backend) ---
# Set this to "true" to run entirely in the browser with seeded demo data.
# Sign in with admin / admin, manager / manager, or rep / rep.
VITE_DEMO_MODE=false

# --- Option 2: real Supabase backend ---
# Required unless VITE_DEMO_MODE=true. From Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
